{
  "$comment": "Parsed from templates/partials/design-tokens.hbs — single source of truth for every meTube report. color = theme-independent brand palette; entity = semantic entity roles; themes = the three CSS custom-property scopes (:root light, [data-theme=dark], [data-theme=glass]).",
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-6": "24px",
    "space-8": "32px"
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "16px"
  },
  "motion": {
    "transition": "0.2s ease"
  },
  "typography": {
    "font-sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-mono": "'JetBrains Mono', 'SF Mono', Menlo, monospace"
  },
  "color": {
    "entity-topic": "#2196F3",
    "entity-repo": "#9C27B0",
    "entity-website": "#FF9800",
    "entity-person": "#F44336"
  },
  "entity": {
    "topic": { "color": "#2196F3", "label": "Topic", "cssVar": "--entity-topic" },
    "repo": { "color": "#9C27B0", "label": "GitHub Repo", "cssVar": "--entity-repo" },
    "website": { "color": "#FF9800", "label": "Website", "cssVar": "--entity-website" },
    "person": { "color": "#F44336", "label": "Person", "cssVar": "--entity-person" }
  },
  "themes": {
    "light": {
      "$scope": ":root",
      "$use": "video report default",
      "bg-primary": "#ffffff",
      "bg-secondary": "#f5f5f5",
      "text-primary": "#333333",
      "text-secondary": "#666666",
      "border-color": "#dddddd",
      "link-color": "#0066cc",
      "accent-color": "#4CAF50"
    },
    "dark": {
      "$scope": "[data-theme=\"dark\"]",
      "$use": "video report toggle",
      "bg-primary": "#1a1a1a",
      "bg-secondary": "#2d2d2d",
      "text-primary": "#e0e0e0",
      "text-secondary": "#b0b0b0",
      "border-color": "#444444",
      "link-color": "#4da6ff",
      "accent-color": "#66BB6A"
    },
    "glass": {
      "$scope": "[data-theme=\"glass\"]",
      "$use": "playlist Research Hub (set on <html>)",
      "bg-primary": "#0a0a0f",
      "bg-secondary": "#14141f",
      "bg-tertiary": "#1a1a2e",
      "text-primary": "#e4e4e7",
      "text-secondary": "#a1a1aa",
      "text-muted": "#71717a",
      "accent-primary": "#a855f7",
      "accent-secondary": "#ec4899",
      "accent-tertiary": "#06b6d4",
      "success": "#10b981",
      "warning": "#f59e0b",
      "border": "#27272a",
      "glass-bg": "rgba(20, 20, 31, 0.6)",
      "glass-border": "rgba(255, 255, 255, 0.1)"
    }
  }
}
