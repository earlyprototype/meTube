{
  "name": "metube-ink",
  "version": "1.0.0",
  "description": "A comprehensive CLI tool for extracting and analysing YouTube videos with dual-layer transcript extraction (YouTube + Whisper AI fallback), automatic entity parsing from transcripts and descriptions, cached playlist discovery, and beautiful interactive HTML reports. Built with Ink.",
  "main": "dist/cli.js",
  "type": "module",
  "bin": {
    "metube": "./dist/cli.js",
    "mtb": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src-ts/cli.tsx",
    "dev:init": "tsx src-ts/cli.tsx init",
    "dev:list": "tsx src-ts/cli.tsx playlist list",
    "dev:discover": "tsx src-ts/cli.tsx playlist discover",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:backend": "tsx scripts/dev/test-backend-integration.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src-ts/**/*.{ts,tsx}\" \"src-ts-v2/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src-ts/**/*.{ts,tsx}\" \"src-ts-v2/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src-ts/**/*.{ts,tsx}\" \"src-ts-v2/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src-ts/**/*.{ts,tsx}\" \"src-ts-v2/**/*.{ts,tsx}\""
  },
  "keywords": [
    "youtube",
    "cli",
    "transcript",
    "whisper",
    "ink",
    "terminal-ui"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/local-auth": "^3.0.1",
    "@google/generative-ai": "^0.24.1",
    "@inkjs/ui": "^2.0.0",
    "@types/node": "^25.0.9",
    "better-sqlite3": "^12.6.2",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-spinners": "^3.4.0",
    "dotenv": "^17.2.3",
    "googleapis": "^170.1.0",
    "handlebars": "^4.7.8",
    "ink": "^6.6.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.1",
    "meow": "^14.0.0",
    "open": "^11.0.0",
    "picomatch": "^4.0.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.1",
    "react": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "youtube-transcript": "^1.2.1",
    "yt-dlp-exec": "^1.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cli-spinners": "^1.3.3",
    "@types/handlebars": "^4.0.40",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.9",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.21.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.5.0",
    "vitest": "^4.0.17"
  }
}
